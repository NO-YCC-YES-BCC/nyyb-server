# docker-compose용 환경변수 — 이 파일을 .env로 복사해 실제 값 기입 (절대 커밋 금지)
# cp .env.example .env

# MariaDB (같은 compose 네트워크의 nyyb-mariadb 컨테이너. 외부 포트는 열지 않음)
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=nyyb-server
DB_URL=jdbc:mariadb://nyyb-mariadb:3306/nyyb-server?useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=nyyb
DB_PASSWORD=

# OpenAI (분석 제안 생성)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_CHAT_TEMPERATURE=0.3

# CLOVA OCR (전성분 인식)
CLOVA_OCR_API_URL=
CLOVA_OCR_SECRET_KEY=

# AWS S3 (업로드 이미지 저장)
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# JWT — 32바이트 이상 랜덤 문자열 (openssl rand -base64 48)
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=3600
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=1209600

# 카카오 로그인 — 리다이렉트 경로는 UserController 기준 /auth/kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://api.hwangs.site/auth/kakao

# 프론트 오리진 (쉼표 구분). 와일드카드 사용 가능
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:5173
