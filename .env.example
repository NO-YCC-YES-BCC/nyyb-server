# docker-compose용 환경변수 — 이 파일을 .env로 복사해 실제 값 기입 (절대 커밋 금지)
# cp .env.example .env

# Aiven MySQL
DB_URL=jdbc:mysql://sottdb-uniway.c.aivencloud.com:27748/defaultdb?sslMode=REQUIRED&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=avnadmin
DB_PASSWORD=

# OpenAI (분석 제안 생성)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_CHAT_TEMPERATURE=0.3

# CLOVA OCR (전성분 인식)
CLOVA_OCR_API_URL=
CLOVA_OCR_SECRET_KEY=

# AWS S3 (업로드 이미지 저장)
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# JWT — 32바이트 이상 랜덤 문자열 (예: openssl rand -base64 48)
# 이 검증 페이지는 비로그인이지만 시큐리티 설정이 값을 요구한다
JWT_SECRET_KEY=

# 프론트를 같은 오리진에서 서빙하므로 보통 그대로 두면 된다
CORS_ALLOWED_ORIGINS=https://sott.site
